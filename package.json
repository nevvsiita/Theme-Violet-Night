{
  "name": "cozy-violet-theme",
  "displayName": "Cozy Violet Night 🐾",
  "description": "A sleek, aesthetic dark purple and lavender theme for Antigravity IDE and VS Code.",
  "version": "1.0.1",
  "icon": "icon.png",
  "engines": {
    "vscode": "^1.60.0"
  },
  "main": "./extension.js",
  "activationEvents": [
    "*"
  ],
  "categories": [
    "Themes"
  ],
  "keywords": [
    "cozy",
    "violet",
    "purple",
    "theme",
    "dark theme"
  ],
  "contributes": {
    "themes": [
      {
        "label": "Cozy Violet Night 🐾",
        "uiTheme": "vs-dark",
        "path": "./themes/cozy-violet-color-theme.json"
      }
    ],
    "snippets": [
      {
        "language": "javascript",
        "path": "./snippets/cat-snippets.json"
      },
      {
        "language": "typescript",
        "path": "./snippets/cat-snippets.json"
      },
      {
        "language": "markdown",
        "path": "./snippets/cat-snippets.json"
      },
      {
        "language": "html",
        "path": "./snippets/cat-snippets.json"
      },
      {
        "language": "css",
        "path": "./snippets/cat-snippets.json"
      }
    ]
  }
}